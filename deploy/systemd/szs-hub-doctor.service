[Unit]
Description=Validate the SZS Hub runtime without network calls
Documentation=file:/opt/szs-hub/current/docs/DEPLOYMENT.md

[Service]
Type=oneshot
User=szshub
Group=szshub-state
WorkingDirectory=/opt/szs-hub/current
EnvironmentFile=/etc/szs-hub/runtime.env
ExecStart=/opt/szs-hub/current/.venv/bin/szs-hub doctor
UMask=0077
StateDirectory=szs-hub
StateDirectoryMode=0750
ReadWritePaths=/var/lib/szs-hub
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
TimeoutStartSec=60s
