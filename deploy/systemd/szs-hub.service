[Unit]
Description=SZS Hub Telegram service
Documentation=file:/opt/szs-hub/current/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=szs-hub-alert@main.service

[Service]
Type=simple
User=szshub
Group=szshub-state
WorkingDirectory=/opt/szs-hub/current
EnvironmentFile=/etc/szs-hub/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/szs-hub/current/.venv/bin/szs-hub doctor
ExecStart=/opt/szs-hub/current/.venv/bin/szs-hub run
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=45s
KillSignal=SIGINT
KillMode=mixed
UMask=0027

# systemd creates /var/lib/szs-hub and /run/szs-hub with safe ownership.
StateDirectory=szs-hub
StateDirectoryMode=0750
RuntimeDirectory=szs-hub
ReadWritePaths=/var/lib/szs-hub

# The bot needs outbound DNS/HTTPS only. It does not need Linux capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=128
LimitNOFILE=4096
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
