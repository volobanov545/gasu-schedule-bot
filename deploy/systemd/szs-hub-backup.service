[Unit]
Description=Create, encrypt, upload, and rotate an SZS Hub backup
Documentation=file:/opt/szs-hub/current/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target
OnFailure=szs-hub-alert@backup.service

[Service]
Type=oneshot
User=szshub-backup
Group=szshub-backup
SupplementaryGroups=szshub-state
WorkingDirectory=/opt/szs-hub/current
EnvironmentFile=/etc/szs-hub/backup.env
ExecStart=/usr/local/libexec/szs-hub-backup
UMask=0077
StateDirectory=szs-hub-backup
StateDirectoryMode=0755
RuntimeDirectory=szs-hub-backup
ReadOnlyPaths=/var/lib/szs-hub
ReadWritePaths=/var/lib/szs-hub-backup /run/szs-hub-backup
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=64
LimitNOFILE=1024
MemoryMax=512M
TimeoutStartSec=2h
