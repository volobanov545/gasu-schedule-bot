[Unit]
Description=Apply SZS Hub database migrations while the bot is stopped
Documentation=file:/opt/szs-hub/current/docs/DEPLOYMENT.md
Conflicts=szs-hub.service
Before=szs-hub.service
OnFailure=szs-hub-alert@migrate.service

[Service]
Type=oneshot
User=szshub
Group=szshub-state
WorkingDirectory=/opt/szs-hub/current
EnvironmentFile=/etc/szs-hub/runtime.env
ExecStart=/opt/szs-hub/current/.venv/bin/szs-hub migrate
UMask=0027
StateDirectory=szs-hub
StateDirectoryMode=0750
ReadWritePaths=/var/lib/szs-hub
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
TimeoutStartSec=10min
