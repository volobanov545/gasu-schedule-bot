# Copy to /etc/szs-hub/backup.env. Never commit the populated file.
# Owner: root:szshub-backup; mode: 0640. The bot account must not read this file.
# This file intentionally contains only the DB location and backup-specific settings.
DATABASE_URL=sqlite+aiosqlite:////var/lib/szs-hub/szs_hub.sqlite3
# The age recipient is public; keep its private identity offline and test recovery.
SZS_HUB_AGE_RECIPIENT=age1replacewitharealpublicrecipient
SZS_HUB_RCLONE_REMOTE=replace-remote:replace-bucket/szs-hub
SZS_HUB_BACKUP_DIR=/var/lib/szs-hub-backup/objects
SZS_HUB_BACKUP_STATUS=/var/lib/szs-hub-backup/last-success
SZS_HUB_BACKUP_CLI=/opt/szs-hub/current/.venv/bin/szs-hub
RCLONE_CONFIG=/etc/szs-hub/rclone.conf
