# Copy to /etc/szs-hub/runtime.env. Never commit the populated file.
# Owner: root:root; mode: 0600. systemd reads it before dropping privileges.
APP_ENV=staging
# This profile receives no Telegram chat updates and publishes schedules only.
FEATURE_PROFILE=schedule_only
# Keep false until the public source, group, and target topic are verified.
LIVE_PROCESSING_APPROVED=false
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
DATABASE_URL=sqlite+aiosqlite:////var/lib/szs-hub/szs_hub.sqlite3
SQLITE_WAL_BACKPORT_CONFIRMED=false
SCHEDULE_STALE_AFTER_MINUTES=360
SCHEDULE_SYNC_MINUTES=15
RUNTIME_HEARTBEAT_STALE_MINUTES=5
TELEGRAM_PROBE_INTERVAL_MINUTES=15
TELEGRAM_PROBE_STALE_MINUTES=30
BACKUP_STATUS_PATH=/var/lib/szs-hub-backup/last-success
BACKUP_STALE_AFTER_HOURS=36

# This mode cannot receive Telegram updates.
TELEGRAM_MODE=outbound_only
TELEGRAM_BOT_TOKEN=
TARGET_CHAT_ID=
SCHEDULE_TOPIC_ID=
# Everything below through ADMIN_USER_IDS is ignored by schedule_only.
GENERAL_TOPIC_ID=
MATERIALS_TOPIC_ID=
ASSISTANT_TOPIC_ID=
HEADMAN_USER_ID=
# Private infrastructure recipient. The account must have started the bot in DM.
ALERT_USER_ID=
ADMIN_USER_IDS=
ATTENDANCE_REACTION=❤
ATTENDANCE_WINDOW_MINUTES=25
EVENING_SCHEDULE_TIME=20:30

SPBGASU_BASE_URL=https://rasp.spbgasu.ru
SPBGASU_GROUP_ID=
SPBGASU_GROUP_NAME=

# Keep AI disabled until provider terms, keys, quotas, and staging output are approved.
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
AI_MAX_RESPONSE_BYTES=1000000
AI_KILL_SWITCH=true
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_TOKEN_LIMIT=100000
AI_PER_USER_DAILY_REQUEST_LIMIT=10
AI_MONTHLY_REQUEST_LIMIT=1000
AI_MONTHLY_TOKEN_LIMIT=1000000
AI_TOKEN_RESERVATION_PER_REQUEST=3000

MATERIAL_AUTO_COPY_THRESHOLD=0.95
MATERIAL_ADMIN_REVIEW_THRESHOLD=0.70
MATERIAL_EXTRACTION_ENABLED=false
MATERIAL_AUTO_DELETE_SOURCE=false
